---
layout: default
---
<article class="academic-home">
  <header class="academic-masthead">
    <div class="academic-identity">
      <h1>{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}</h1>
    </div>

    {% if page.profile.image %}
      <div class="academic-portrait">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% assign profile_image_alt = site.first_name | append: ' ' | append: site.last_name %}
        {% include figure.liquid loading="eager" path=profile_image_path class="academic-portrait-image" sizes="(max-width: 575px) 96px, 180px" alt=profile_image_alt cache_bust=true %}
      </div>
    {% endif %}

    <nav class="academic-social" aria-label="Academic and social profiles">
      {% for link in page.profile.links %}
        <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ link.label }}" title="{{ link.label }}">
          <i class="{{ link.icon }}" aria-hidden="true"></i>
          <span>{{ link.label }}</span>
        </a>
      {% endfor %}
    </nav>

    <div class="academic-bio">{{ content }}</div>
  </header>

  {% if page.selected_papers %}
    <section class="academic-section academic-papers" aria-labelledby="papers-heading">
      <div class="academic-section-heading">
        <h2 id="papers-heading">Selected publications</h2>
        <a class="section-more" href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">→</span></a>
      </div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  {% if page.announcements.enabled %}
    <section class="academic-section academic-news" aria-labelledby="news-heading">
      <div class="academic-section-heading">
        <h2 id="news-heading">News</h2>
        <a class="section-more" href="{{ '/news/' | relative_url }}">Archive <span aria-hidden="true">→</span></a>
      </div>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  {% if page.academic_service %}
    <section class="academic-section academic-service" aria-labelledby="service-heading">
      <div class="academic-section-heading">
        <h2 id="service-heading">Academic service</h2>
      </div>
      <dl>
        {% for service in page.academic_service %}
          <div><dt>{{ service.role }}</dt><dd>{{ service.details }}</dd></div>
        {% endfor %}
      </dl>
    </section>
  {% endif %}
</article>
